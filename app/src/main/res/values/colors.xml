<!--
  ~ 剩下的都是「不随主题走」的字面量：启动器快捷方式图标、默认头像、评分星、Cookie 图标。
  ~ 旧的 `colorPrimary` / `colorAccent` / `content` / `widget` / `divider` / `progress`
  ~ 那一整套（外加 `values-night` 的深色副本）是给 XML 主题和旧 View 用的，消费方已经
  ~ 全部删掉，主题色一律来自 Compose 的 `ColorScheme`。
  -->
<resources>

    <!--Shortcut background-->
    <color name="shortcut_bg">#F5F5F5</color>

    <!-- 冷启动那一帧的窗口底色；进入 Composition 之后由 EhNavHostActivity 按色板重铺 -->
    <color name="window_background">#FFFFFFFF</color>

    <color name="teal_500">#ff009688</color>
    <color name="yellow_800">#fff9a825</color>
    <color name="brown_500">#ff795548</color>

</resources>
