<resources>
    <style name="AppTheme" parent="Base.AppTheme.Light" />

    <!-- Progress View -->
    <style name="ProgressView">
        <item name="indicatorColor">?attr/progressColor</item>
        <item name="android:indeterminate">true</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Indicating">
        <item name="indicatorHeight">1dp</item>
        <item name="indicatorColor">?attr/dividerColor</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialComponents.NavigationView" parent="">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
