<!--
  ~ 窗口主题只做三件事，其它一概不管：
  ~   1. 给 Activity 一个 NoActionBar + DayNight 的壳（系统的深色资源限定符要能生效）；
  ~   2. 给 `?attr/colorPrimary` / `?attr/colorControlNormal` 一点兜底值 ——
  ~      `res/drawable` 里还有一批老矢量图用它们做 `android:tint`，Compose 侧虽然都会用
  ~      `Icon(tint = …)` 覆盖掉，但属性不存在时矢量解析会拿到空值，所以留着；
  ~   3. 让 AppCompat 的 Dialog / BiometricPrompt 有合规的宿主主题。
  ~
  ~ 页面上的颜色一律来自 Compose 的 `ColorScheme`（`EhTheme`），窗口底色由
  ~ `EhNavHostActivity` 按 `ehWindowBackground()` 重铺。这里不再依赖 MDC
  ~ （`Theme.Material3.*`），所以 `com.google.android.material:material` 已经移除。
  -->
<resources>

    <style name="Theme.EhViewer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- 冷启动第一帧（还没进 Composition）能看到的就是它，深色下由 values-night 给纯黑 -->
        <item name="android:windowBackground">@color/window_background</item>
        <item name="colorPrimary">@color/teal_500</item>
        <item name="colorPrimaryDark">@color/teal_500</item>
        <item name="colorAccent">@color/teal_500</item>
    </style>

</resources>
